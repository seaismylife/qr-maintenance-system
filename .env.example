# ==============================================================================
# Environment Configuration
# ==============================================================================
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change_me_to_a_random_32_byte_secret

# ==============================================================================
# Option A: TiDB Cloud Serverless (Recommended for Render)
# Either provide a single DATABASE_URL or individual MYSQL_* parameters below.
# ==============================================================================
# DATABASE_URL=mysql://<prefix>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/test?sslmode=verify-full

# OR individual TiDB variables:
# MYSQL_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# MYSQL_PORT=4000
# MYSQL_USER=<prefix>.root
# MYSQL_PASSWORD=<your_tidb_password>
# MYSQL_DB=test
# MYSQL_SSL_DISABLED=0

# ==============================================================================
# Option B: Local Development (XAMPP / Local MySQL)
# ==============================================================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=qr_maintenance_db
MYSQL_POOL_SIZE=10
MYSQL_SSL_DISABLED=1

# ==============================================================================
# Server & Production Networking Settings
# ==============================================================================
HOST=0.0.0.0
PORT=5000
# Set to your deployed Render URL (e.g. https://qr-maintenance-system.onrender.com)
PUBLIC_BASE_URL=http://localhost:5000

# When deployed behind Render proxy / SSL termination:
BEHIND_PROXY=1
PROXY_FIX_NUM_PROXIES=1
SESSION_COOKIE_SECURE=1
MAX_CONTENT_LENGTH=8388608

